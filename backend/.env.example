# Copy to .env and adjust. Everything has a sensible default for local use.

# Leave unset to use a local SQLite file (backend/dev.db). For hosting, paste
# a Postgres connection string, e.g. from Neon.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The demo data is built around Oct 19, 2026. Set to an empty value to use
# the real date once you work with a real cohort.
# DEMO_TODAY=2026-10-19

# POST /api/reset reloads the sample data. Turn off anywhere real data lives.
# ALLOW_RESET=true
