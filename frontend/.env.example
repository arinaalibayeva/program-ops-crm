# Copy to .env.local. Restart `npm run dev` after changing it.

# true: load and save through the backend. false or unset: sample data in this browser only.
NEXT_PUBLIC_USE_BACKEND=true

# Where the backend runs. Defaults to http://localhost:8000.
# BACKEND_URL=http://localhost:8000

# true: ask staff to sign in (set REQUIRE_SIGN_IN=true on the backend too).
# Unset: the site opens straight on the dashboard as the program manager.
# NEXT_PUBLIC_REQUIRE_SIGN_IN=true
